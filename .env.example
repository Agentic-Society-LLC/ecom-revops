# Copy to .env and fill in only the sources you use. Never commit .env (it is in .gitignore).
# You create every key yourself in the source's own settings page. Never paste one into a chat.

# --- Shopify (orders + revenue) ---
SHOPIFY_STORE=yourstore.myshopify.com
SHOPIFY_TOKEN=
SHOPIFY_API_VERSION=        # a current version from shopify.dev/docs/api/usage/versioning

# --- Funnel (sessions, add to cart, checkout) ---
FUNNEL_CSV=                 # path to the Shopify "Conversion over time" daily export, or a CSV URL

# --- Stripe (cash collected) ---
STRIPE_KEY=                 # a RESTRICTED key, Read on Balance transactions only

# --- Meta Ads (spend) ---
META_TOKEN=
META_AD_ACCOUNT=            # digits only, no act_
META_API_VERSION=           # a current Graph API version

# --- GoHighLevel (leads, deals) - optional ---
GHL_TOKEN=
GHL_LOCATION_ID=

# --- Anything else ---
EXTRA_CSV_URL=              # any CSV with a date column (published Google Sheet, Zapier, Make)

# --- Slack ---
SLACK_BOT_TOKEN=            # xoxb-...
SLACK_APP_TOKEN=            # xapp-... (chat bot only)
SLACK_CHANNEL=              # C0...
SLACK_OWNER_ID=             # U0... (outage DMs)

# --- Chat brain (optional) ---
ANTHROPIC_API_KEY=
